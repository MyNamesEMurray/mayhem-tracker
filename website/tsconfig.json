{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // src/lib/stats.ts re-exports ../../../src/shared/score.ts by full path so
    // plain Node can resolve it as well as Vite
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
