{
  "name": "mayhem-tracker",
  "version": "2.14.0",
  "description": "ARAM Mayhem match history tracker",
  "license": "MIT",
  "author": "MyNamesEMurray",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p .design-sync/previews-tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.mts\"",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps",
    "dist": "npm run typecheck && electron-vite build && electron-builder --win --publish never",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen:augments": "node scripts/gen-augment-descriptions.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "league-connect": "^6.0.0-rc13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "oxfmt": "^0.35.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.mayhem-tracker.app",
    "productName": "MayhemStats Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "assets/icon.png",
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "signExecutable": false
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "portable": {
      "artifactName": "MayhemTracker-Portable.exe"
    },
    "nsis": {
      "artifactName": "MayhemTracker-Setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
